# Copy to .env; .env is gitignored. Every variable here must match
# env.schema.js — checked by `npm run check:env`.

# development | production | test
NODE_ENV=development

# HTTP port the app listens on
PORT=3000

# Port of the Postgres order API (npm run orders-api)
ORDERS_API_PORT=3001

# Postgres connection string WITHOUT credentials, pointing at PgBouncer (6432), not Postgres itself.
# The password comes from DB_PASSWORD_FILE
DB_URL=postgres://marketplace@localhost:6432/marketplace

# RabbitMQ (AMQP port 5672, not the 15672 management UI). The real value,
# with credentials, lives in the vault next to DB_URL
BROKER_URL=amqp://USER:PASSWORD@localhost:5672

# Redis for the cache and rate-limit counters (maxmemory + allkeys-lru)
REDIS_URL=redis://localhost:6380

# Redis for BullMQ and sessions (noeviction + AOF). A different instance
REDIS_QUEUE_URL=redis://localhost:6381

# Path to the file holding the current DB password (rotate.sh rewrites it)
DB_PASSWORD_FILE=./secrets/db_password

# Hours an Idempotency-Key is remembered before a stuck "in-flight" entry is freed
IDEMPOTENCY_TTL_HOURS=24

# debug | info | warn | error
LOG_LEVEL=info
