# Copy to .env; .env is gitignored. Every variable here must match
# env.schema.js — checked by `npm run check:env`.

# development | production | test
NODE_ENV=development

# HTTP port the app listens on
PORT=3000

# Port of the Postgres order API (npm run orders-api)
ORDERS_API_PORT=3001

# Postgres connection string WITHOUT credentials, pointing at PgBouncer (6432), not Postgres itself.
# The password comes from DB_PASSWORD_FILE
DB_URL=postgres://marketplace@localhost:6432/marketplace

# RabbitMQ (AMQP port 5672, not the 15672 management UI). The real value,
# with credentials, lives in the vault next to DB_URL
BROKER_URL=amqp://USER:PASSWORD@localhost:5672

# Redis for the cache and rate-limit counters (maxmemory + allkeys-lru)
REDIS_URL=redis://localhost:6380

# Redis for BullMQ and sessions (noeviction + AOF). A different instance
REDIS_QUEUE_URL=redis://localhost:6381

# Access-token signing (ES256). Real values live only in the vault, never here.
# PEM goes base64-encoded in one line: JWT_PRIVATE_KEY is a PKCS#8 EC P-256 key,
# JWT_PUBLIC_KEY its SPKI public half, JWT_KID the id put into every token header
JWT_KID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Only during a key rotation: the previous public key, still accepted, never used to sign
JWT_PREV_KID=
JWT_PREV_PUBLIC_KEY=

# HMAC pepper for refresh-token hashes, at least 32 characters, from the vault
REFRESH_TOKEN_PEPPER=

# S3-compatible object storage. Empty endpoint means AWS S3 itself; for the
# local MinIO from docker-compose.yml it's http://localhost:9900
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
# Access to every file in the bucket: only in the vault, never here
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=marketplace-files

# Port of the asset edge (npm run edge), the local stand-in for CloudFront
EDGE_PORT=9910

# Path to the file holding the current DB password (rotate.sh rewrites it)
DB_PASSWORD_FILE=./secrets/db_password

# Hours an Idempotency-Key is remembered before a stuck "in-flight" entry is freed
IDEMPOTENCY_TTL_HOURS=24

# debug | info | warn | error
LOG_LEVEL=info
