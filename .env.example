# Copy to .env; .env is gitignored. Every variable here must match
# env.schema.js — checked by `npm run check:env`.

# development | production | test
NODE_ENV=development

# HTTP port the app listens on
PORT=3000

# Postgres connection string WITHOUT credentials — the password comes from DB_PASSWORD_FILE
DB_URL=postgres://marketplace@localhost:5432/marketplace

# Path to the file holding the current DB password (rotate.sh rewrites it)
DB_PASSWORD_FILE=./secrets/db_password

# Hours an Idempotency-Key is remembered before a stuck "in-flight" entry is freed
IDEMPOTENCY_TTL_HOURS=24

# debug | info | warn | error
LOG_LEVEL=info
