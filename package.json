{
  "name": "marketplace-api",
  "version": "1.1.0",
  "description": "Marketplace API: fail-fast config (zod) + rotating DB password read from a secret file, no restart required.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.mjs",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "check:env": "node scripts/check-env-example.mjs",
    "build": "tsc",
    "migrate": "bash scripts/with-secrets.sh dev typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev typeorm migration:revert -d dist/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",
    "backup": "bash scripts/with-secrets.sh dev bash scripts/backup.sh",
    "restore-drill": "bash scripts/with-secrets.sh dev bash scripts/restore-drill.sh",
    "build:test": "tsc -p tsconfig.test.json",
    "test:integration": "npm run build:test && node --experimental-vm-modules node_modules/.bin/jest dist-test/test/integration",
    "test:e2e": "npm run build:test && node --experimental-vm-modules node_modules/.bin/jest dist-test/test/e2e",
    "test:contract": "npm run build:test && node --experimental-vm-modules node_modules/.bin/jest dist-test/test/contract/consumer",
    "verify:provider": "npm run build:test && node dist-test/test/contract/provider/verify.js"
  },
  "keywords": [
    "openapi",
    "express",
    "express-openapi-validator",
    "zod",
    "config",
    "fail-fast",
    "secrets",
    "postgres",
    "password-rotation"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.4",
    "typeorm": "0.3.31",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.4",
    "@redocly/cli": "2.46.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "22.15.29",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "socket.io-client": "4.8.4",
    "supertest": "^7.3.0",
    "typescript": "5.9.3"
  }
}
